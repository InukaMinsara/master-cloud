{
  "name": "master-cloud",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "node scripts/testRunner.js",
    "bot:keys": "node scripts/xkiro-bot.mjs",
    "drive:start": "node scripts/webdav-server.mjs",
    "drive:install": "node scripts/webdav-server.mjs --install",
    "storage:start": "node scripts/local-storage-90tb.mjs",
    "storage:install": "node scripts/local-storage-90tb.mjs --install",
    "package:zip": "node scripts/build-deployment-package.mjs",
    "preview": "vite preview",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:build": "node scripts/build-desktop.mjs"
  },
  "main": "desktop/main.cjs",

  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "webdav-server": "^2.6.3"
  },
  "build": {
    "appId": "com.mastercloud.desktop",
    "productName": "Master Cloud",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Master Cloud",
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "protocols": [
      {
        "name": "Master Cloud",
        "schemes": [
          "mastercloud"
        ]
      }
    ],
    "files": [
      "desktop/**/*",
      "scripts/webdav-server.mjs",
      "scripts/cloud-manifest.json",
      "scripts/bin/rclone.exe",
      "public/logo-icon.svg"
    ],
    "asarUnpack": [
      "scripts/**/*"
    ]
  }
}
