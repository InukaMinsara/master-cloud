# ─── MASTER CLOUD — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env — it is already in .gitignore.

# ── Supabase (PUBLIC — safe for frontend) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── IMPORTANT ────────────────────────────────────────────────────────────────
# The Supabase SERVICE ROLE KEY must NEVER appear here or anywhere in src/.
# It is for server-side use only (edge functions, scripts run on your own machine).
