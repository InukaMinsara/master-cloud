# ─── MASTER CLOUD — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env — it is already in .gitignore.

# ── Supabase (PUBLIC — safe for frontend) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Telegram Cloud Engine (Optional Platform Storage) ────────────────────────
# Bot Token from @BotFather and private channel/chat ID
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id_here

# ── MASTER AI — Multi-Provider Configuration (Configured in .env.local) ──
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1
GROQ_API_KEY=

XKIRO_API_ENDPOINT=https://api.xkiro.com/v1
XKIRO_API_KEY=

POLLINATIONS_API_ENDPOINT=https://gen.pollinations.ai
POLLINATIONS_API_KEY=

COMFYUI_LOCAL_ENDPOINT=http://127.0.0.1:8188
COMFYUI_LOCAL_API_KEY=

EXPERIENTIAL_LABS_API_ENDPOINT=https://api.experientiallabs.com/v1
EXPERIENTIAL_LABS_API_KEY=

UNOROUTER_API_ENDPOINT=https://api.unorouter.com/v1
UNOROUTER_API_KEY=

ABHIBOTS_API_ENDPOINT=https://api.abhibots.com/v1
ABHIBOTS_API_KEY=

APMIX_API_ENDPOINT=https://api.apmix.net/v1
APMIX_API_KEY=

OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ── IMPORTANT ────────────────────────────────────────────────────────────────
# All API keys must remain strictly in .env.local on the server.
# NEVER expose secrets in frontend bundles or logs.
