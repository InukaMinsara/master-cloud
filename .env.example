# ─── MASTER CLOUD — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env — it is already in .gitignore.

# ── Supabase (PUBLIC — safe for frontend) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Telegram Cloud Engine (Optional Platform Storage) ────────────────────────
# Bot Token from @BotFather and private channel/chat ID
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id_here

# ── IMPORTANT ────────────────────────────────────────────────────────────────
# The Supabase SERVICE ROLE KEY and live secrets must NEVER appear here or in git.
# Keep real credentials only in your local uncommitted .env file.
